R3NGINE_URL=https://your-r3ngine-host
R3NGINE_MCP_API_KEY=r3n_mcp_replace-with-shown-once-secret
# stdio (IDE) or http (local sidecar)
MCP_TRANSPORT=stdio
MCP_BIND=127.0.0.1
MCP_PORT=3100
MCP_UNAUTH_MAX=10
MCP_UNAUTH_WINDOW_MS=60000
# Full path to ca.crt on this computer (setup writes this so agents can find it)
# Local checkout: secrets/certs/ca.crt
# Remote: copy that file from the r3ngine host, then set the absolute path here
R3NGINE_CA_CERT=
NODE_EXTRA_CA_CERTS=
# Set when connecting to 127.0.0.1 against a cert issued for DOMAIN_NAME
# R3NGINE_TLS_SERVER_NAME=r3ngine.example.com
